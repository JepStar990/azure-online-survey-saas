{
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "{tenant-id}",
    "ClientId": "{api-client-id}",
    "Authority": "https://login.microsoftonline.com/{tenant-id}/v2.0",
    "Audience": "api://{api-client-id}"
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "UseInMemory": true,
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "RateLimiting": {
    "AnonymousResponseLimit": 30,
    "WindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  }
}
